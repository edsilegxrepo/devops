# ==============================================================================
# /opt/scripts/config/common.env
# Global Server Configuration & Shared Defaults
# Host: cs-us-pweb001.criticalsys.net
# Syntax: POSIX shell key-value pairs (systemd EnvironmentFile compatible)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Host Identity
# ------------------------------------------------------------------------------
SYS_HOSTNAME="cs-us-pweb001.criticalsys.net"
SHORT_HOSTNAME="cs-us-pweb001"

# ------------------------------------------------------------------------------
# 2. Email Notification Routing (Local Postfix MTA)
# ------------------------------------------------------------------------------
MAIL_TO="criticalsys.mis@gmail.com"
MAIL_FROM_NAME="DevOps Automation"
MAIL_FROM_DOMAIN="criticalsys.net"
MAIL_FROM="DevOps Automation <do-not-reply@cs-us-pweb001.criticalsys.net>"
SENDMAIL_BIN="/usr/sbin/sendmail"

# ------------------------------------------------------------------------------
# 3. System Logging & Audit Standards
# ------------------------------------------------------------------------------
LOG_BASE_DIR="/var/log/jobs"
BACKUP_LOG_DIR="/var/log/backups"
DEFAULT_LOG_RETENTION_DAYS="14"

# POSIX user & group ownership of log files and backup artifacts
SYS_USER="csysadm"
SYS_GROUP="root"

# File creation permissions (octal)
SYS_DIR_PERMS="0750"
SYS_FILE_PERMS="0640"
