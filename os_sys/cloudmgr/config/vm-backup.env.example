# ==============================================================================
# /opt/scripts/config/vm-backup.env
# Job Configuration: VM Snapshot & Cloud Backup
# Host: cs-us-pweb001.criticalsys.net
# Syntax: POSIX shell key-value pairs (systemd EnvironmentFile compatible)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backup Storage Locations & Targets
# ------------------------------------------------------------------------------
BACKUP_DIR="/var/backups/vm-snapshots"
ARCHIVE_PREFIX="cs-pweb001-backup"
TARGET_REMOTE="gdrive:cs-us-pweb001"
TARGET_REMOTE_TYPE="rclone"
# Optional secondary remote target for 3-2-1 offsite redundancy (e.g. b2:bucket, s3:bucket, or sftp:user@host:/path)
TARGET_SECONDARY_REMOTE=""
TARGET_SECONDARY_TYPE="rclone"

# ------------------------------------------------------------------------------
# 2. Encryption & Security Standards
# ------------------------------------------------------------------------------
PASSPHRASE_FILE="/root/.secrets/backup-passphrase"

# ------------------------------------------------------------------------------
# 3. Lifecycle & Retention Policies (Days)
# ------------------------------------------------------------------------------
LOCAL_RETENTION_DAYS="2"
REMOTE_RETENTION_DAYS="14"
LOG_RETENTION_DAYS="14"

# ------------------------------------------------------------------------------
# 4. Compression & Pipeline Tuning
# ------------------------------------------------------------------------------
COMPRESSION_PROGRAM="zstd -T0 -3"
COMPRESSION_EXT="tar.zst.gpg"
MIN_ARCHIVE_BYTES="1048576"

# ------------------------------------------------------------------------------
# 5. Backup File System Scope & Exclusions (Space-separated strings)
# ------------------------------------------------------------------------------
BACKUP_ROOT_DIRS="home root etc opt var/www var/lib/caddy"
BACKUP_EXCLUDES="root/.gnupg/S.gpg-agent* home/*/.antigravity* home/*/.gemini* root/.antigravity* root/.gemini* home/*/.cache* root/.cache*"

# ------------------------------------------------------------------------------
# 6. Database Drivers & Integration
# ------------------------------------------------------------------------------
SQLITE_DATABASES="/var/lib/uptime-kuma/data/kuma.db /var/lib/ntfy/data/user.db /var/lib/ntfy/cache/cache.db"

# ------------------------------------------------------------------------------
# 7. Extensibility Lifecycle Hooks (Optional paths to executables)
# ------------------------------------------------------------------------------
PRE_BACKUP_HOOK=""
POST_BACKUP_HOOK=""
