# ==============================================================================
# /opt/scripts/config/pkg-updates.env.example
# Job Configuration: OS Package Update Detection & Advisory
# Syntax: POSIX shell key-value pairs (systemd EnvironmentFile compatible)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Manager & Execution Settings
# ------------------------------------------------------------------------------
PKG_MGR="dnf"
CHECK_TIMEOUT="600"

# Force package manager to refresh repository metadata before inspection to avoid
# false negatives caused by stale local cache (e.g. metadata_expire 24h default).
REFRESH_METADATA="true"

# ------------------------------------------------------------------------------
# 2. Notification Policies
# ------------------------------------------------------------------------------
# When true, emails are dispatched only if updates are detected.
# When false, routine reports are always delivered.
# Note: The systemd service passes --notify-new-only by default.
NOTIFY_NEW_ONLY="false"

# When true, only packages with security advisories trigger notifications / listing.
CHECK_SECURITY_ONLY="false"

# ------------------------------------------------------------------------------
# 3. Package Scope & Exclusions (Space-separated list of package names / globs)
# ------------------------------------------------------------------------------
# Example: EXCLUDED_PACKAGES="kernel* kmod-*"
EXCLUDED_PACKAGES=""
