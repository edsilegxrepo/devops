# ==============================================================================
# Environment Configuration Template for <name>
# ==============================================================================
# Installed to: %{_sysconfdir}/<name>/<name>.env
# Loaded by:    %{_unitdir}/<name>.service (EnvironmentFile=-/etc/<name>/<name>.env)
# Permissions:  0640 (<name>:<name>)
# ==============================================================================

# Logging level: trace, debug, info, warn, error
LOG_LEVEL="info"

# Network listen address and port (if applicable)
# LISTEN_ADDR="127.0.0.1:8080"

# Persistent state/data directory override
# DATA_DIR="/var/lib/<name>"

# Additional runtime command-line arguments
# ARGS=""

